{
  "id": "nested-loops",
  "title": "Nested loops",
  "segments": [
    {
      "example": "TwoDArray",
      "extra": false,
      "title": "Row by row, column by column",
      "code": [
        "int[][] matrix = {",
        "    {1, 2, 3}, // Row 0",
        "    {4, 5, 6}, // Row 1",
        "    {7, 8, 9}  // Row 2",
        "};",
        "System.out.println(\"Element at (1,2): \" + matrix[1][2]);",
        "matrix[0][0] = 10;",
        "for (int i = 0; i < matrix.length; i++) {",
        "    for (int j = 0; j < matrix[i].length; j++) {",
        "        System.out.print(matrix[i][j] + \" \");",
        "    }",
        "    System.out.println();",
        "}"
      ],
      "steps": [
        {
          "line": 1,
          "caption": "`matrix` points at a 2D array: an array of rows. Three rows, each with three columns.",
          "vars": [{"name": "matrix", "ref": "M"}],
          "arrays": [{"id": "M", "rows": [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 6,
          "caption": "`matrix[1][2]` means row 1 first, then column 2 in that row: 6.",
          "print": "Element at (1,2): 6\n",
          "from": {"array": "M", "row": 1, "col": 2},
          "vars": [{"name": "matrix", "ref": "M"}],
          "arrays": [{"id": "M", "rows": [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[1, 2]]}]
        },
        {
          "line": 7,
          "caption": "`matrix[0][0] = 10` replaces the 1 in row 0, column 0.",
          "vars": [{"name": "matrix", "ref": "M"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[0, 0]]}]
        },
        {
          "line": 8,
          "caption": "The outer loop picks a row: `i` is 0. `0 < matrix.length` (3 rows) is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 9,
          "caption": "The inner loop walks along row `i`: `j` is 0. `0 < matrix[0].length` (3 columns) is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Prints `matrix[0][0]` and a space. `print`, not `println`, so the output stays on this line.",
          "print": "10 ",
          "from": {"array": "M", "row": 0, "col": 0},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[0, 0]]}]
        },
        {
          "line": 9,
          "caption": "`j++` makes `j` 1. `1 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 0, column 1: prints 2 and a space.",
          "print": "2 ",
          "from": {"array": "M", "row": 0, "col": 1},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[0, 1]]}]
        },
        {
          "line": 9,
          "caption": "`j++` makes `j` 2. `2 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 0, column 2: prints 3 and a space.",
          "print": "3 ",
          "from": {"array": "M", "row": 0, "col": 2},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[0, 2]]}]
        },
        {
          "line": 9,
          "caption": "`j` is 3. `3 < 3` is false, so the inner loop ends: row 0 is done.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}, {"name": "j", "value": "3"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 12,
          "caption": "`System.out.println()` with nothing inside just ends the line.",
          "print": "\n",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 8,
          "caption": "`i++` moves to row 1. `1 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 9,
          "caption": "The inner loop starts again: a new `j`, starting at 0. `0 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 1, column 0: prints 4 and a space.",
          "print": "4 ",
          "from": {"array": "M", "row": 1, "col": 0},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[1, 0]]}]
        },
        {
          "line": 9,
          "caption": "`j++` makes `j` 1. `1 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 1, column 1: prints 5 and a space.",
          "print": "5 ",
          "from": {"array": "M", "row": 1, "col": 1},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[1, 1]]}]
        },
        {
          "line": 9,
          "caption": "`j++` makes `j` 2. `2 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 1, column 2: prints 6 and a space.",
          "print": "6 ",
          "from": {"array": "M", "row": 1, "col": 2},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[1, 2]]}]
        },
        {
          "line": 9,
          "caption": "`j` is 3. `3 < 3` is false: row 1 is done.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}, {"name": "j", "value": "3"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 12,
          "caption": "The line ends.",
          "print": "\n",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 8,
          "caption": "`i` is 2, the last row. `2 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 9,
          "caption": "The inner loop starts again: a new `j`, starting at 0. `0 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "0"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 2, column 0: prints 7 and a space.",
          "print": "7 ",
          "from": {"array": "M", "row": 2, "col": 0},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "0"}],

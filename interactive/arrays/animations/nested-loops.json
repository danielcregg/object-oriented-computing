          "caption": "`j++` makes `j` 1. `1 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 10,
          "caption": "Row 2, column 1: prints 8 and a space.",
          "print": "8 ",
          "from": {"array": "M", "row": 2, "col": 1},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "1"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[2, 1]]}]
        },
        {
          "line": 9,
          "caption": "`j++` makes `j` 2. `2 < 3` is true.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {

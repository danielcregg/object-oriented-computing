          "from": {"array": "M", "row": 2, "col": 2},
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]], "highlight": [[2, 2]]}]
        },
        {
          "line": 9,
          "caption": "`j` is 3. `3 < 3` is false: row 2 is done.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}, {"name": "j", "value": "3"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 12,
          "caption": "The last line ends.",
          "print": "\n",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "2"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        },
        {
          "line": 8,
          "caption": "`i` is 3. `3 < 3` is false, so the outer loop ends too: every row is printed.",
          "vars": [{"name": "matrix", "ref": "M"}, {"name": "i", "value": "3"}],
          "arrays": [{"id": "M", "rows": [["10", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]}]
        }
      ]
    }

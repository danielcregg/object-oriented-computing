          "flow": [
            {"from": {"array": "St", "index": 0}, "to": {"array": "B", "index": 5}, "text": "S"},
            {"from": {"array": "St", "index": 1}, "to": {"array": "B", "index": 6}, "text": "t"},
            {"from": {"array": "St", "index": 2}, "to": {"array": "B", "index": 7}, "text": "r"},
            {"from": {"array": "St", "index": 3}, "to": {"array": "B", "index": 8}, "text": "i"},
            {"from": {"array": "St", "index": 4}, "to": {"array": "B", "index": 9}, "text": "n"},
            {"from": {"array": "St", "index": 5}, "to": {"array": "B", "index": 10}, "text": "g"},
            {"from": {"array": "St", "index": 6}, "to": {"array": "B", "index": 11}, "text": "s"}
          ]
        },
        {

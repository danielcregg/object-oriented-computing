      "example": "section 6",
      "extra": false,
      "title": "append writes into the same object",
      "code": [
        "StringBuilder sb = new StringBuilder(\"Java\");",
        "sb.append(\" \").append(\"Strings\");",
        "String result = sb.toString();"
      ],
      "steps": [
        {
          "line": 1,
          "caption": "`sb` points at one StringBuilder object. It holds the four characters, then 16 empty slots: room to grow without building a new object.",
          "vars": [{"name": "sb", "ref": "B"}],
          "arrays": [{"id": "B", "text": "Java", "class": "StringBuilder", "capacity": 20}]
        },
        {
          "line": 2,
          "caption": "`append(\" \")` writes the space into the next empty slot. The same object, edited in place: `sb`'s arrow never moves.",
          "vars": [{"name": "sb", "ref": "B"}],
          "arrays": [
            {"id": "Sp", "text": " ", "class": "String", "pool": true},
            {"id": "B", "text": "Java ", "class": "StringBuilder", "capacity": 20}

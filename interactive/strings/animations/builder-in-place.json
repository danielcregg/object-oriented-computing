          "flow": [
            {"from": {"array": "R2", "index": 0}, "to": {"array": "R3", "index": 0}, "text": "h"},
            {"from": {"array": "R2", "index": 1}, "to": {"array": "R3", "index": 1}, "text": "a"},
            {"from": {"array": "R2", "index": 2}, "to": {"array": "R3", "index": 2}, "text": "h"},
            {"from": {"array": "R2", "index": 3}, "to": {"array": "R3", "index": 3}, "text": "a"},
            {"from": {"array": "HA", "index": 0}, "to": {"array": "R3", "index": 4}, "text": "h"},
            {"from": {"array": "HA", "index": 1}, "to": {"array": "R3", "index": 5}, "text": "a"}
          ]
        },

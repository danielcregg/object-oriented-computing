            {"id": "R1", "text": "ha", "class": "String", "dead": true},
            {"id": "R2", "text": "haha", "class": "String", "dead": true},
            {"id": "R3", "text": "hahaha", "class": "String", "dead": true},
            {"id": "R4", "text": "hahahaha", "class": "String"}
          ],
          "flow": [
            {"from": {"array": "R3", "index": 0}, "to": {"array": "R4", "index": 0}, "text": "h"},
            {"from": {"array": "R3", "index": 1}, "to": {"array": "R4", "index": 1}, "text": "a"},
            {"from": {"array": "R3", "index": 2}, "to": {"array": "R4", "index": 2}, "text": "h"},

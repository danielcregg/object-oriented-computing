      "title": "What if the index is the length?",
      "code": [
        "String message = \"Java Strings Lab\";",
        "System.out.println(message.charAt(15));",
        "System.out.println(message.charAt(16));"
      ],
      "steps": [
        {
          "line": 1,
          "caption": "The same 16 characters, indexes 0 to 15.",
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [{"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "ruler": "length 16"}]
        },
        {
          "line": 2,
          "caption": "Index 15 is the last box, one less than the length: `b`.",
          "print": "b\n",
          "from": {"array": "M", "index": 15},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {
              "id": "M",
              "text": "Java Strings Lab",
              "class": "String",
              "pool": true,
              "highlight": [15],
              "ruler": "length 16"
            }
          ]
        },
        {
          "line": 3,
          "caption": "Index 16 is one past the end. There is no box 16, so Java stops the program with an exception. `charAt(0)` on an empty String fails the same way: it has no box 0.",
          "error": "StringIndexOutOfBoundsException: Index 16 out of bounds for length 16",
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {
              "id": "M",
              "text": "Java Strings Lab",
              "class": "String",
              "pool": true,
              "highlight": [16],
              "ghost": 16,

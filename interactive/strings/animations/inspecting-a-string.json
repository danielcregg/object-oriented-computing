{
  "id": "inspecting-a-string",
  "title": "Inspecting a String",
  "layout": "wide",
  "segments": [
    {
      "example": "StringInspector",
      "extra": false,
      "title": "Ask a String about itself",
      "code": [
        "String message = \"Java Strings Lab\";",
        "System.out.println(\"Message: \" + message);",
        "System.out.println(\"Length: \" + message.length());",
        "System.out.println(\"First char: \" + message.charAt(0));",
        "System.out.println(\"Uppercase: \" + message.toUpperCase());",
        "System.out.println(\"Lowercase: \" + message.toLowerCase());",
        "System.out.println(\"Is empty? \" + message.isEmpty());"
      ],
      "steps": [
        {
          "line": 1,
          "caption": "`message` holds an arrow to a String object. Its 16 characters sit in a row of boxes numbered from index 0. A literal like this one lives in the string pool.",
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [{"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true}]
        },
        {
          "line": 2,
          "caption": "Printing joins the label to the text. Reading a String never changes it.",
          "print": "Message: Java Strings Lab\n",
          "from": {"array": "M"},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [{"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true}]
        },
        {
          "line": 3,
          "caption": "`length()` counts the characters, the spaces included: 16. So the indexes run from 0 to 15, one less than the length.",
          "print": "Length: 16\n",
          "from": {"array": "M"},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [{"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "ruler": "length 16"}]
        },
        {
          "line": 4,
          "caption": "`charAt(0)` reads the box at index 0: the `char` `J`, a single character.",
          "print": "First char: J\n",
          "from": {"array": "M", "index": 0},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [{"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "highlight": [0]}]
        },
        {
          "line": 5,
          "caption": "`toUpperCase()` cannot change `message`: a String never changes. It builds a brand-new String, copying each character as a capital, and hands back an arrow to it.",
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true},
            {"id": "U", "text": "JAVA STRINGS LAB", "class": "String"}
          ],
          "flow": [
            {"from": {"array": "M", "index": 0}, "to": {"array": "U", "index": 0}, "text": "J"},
            {"from": {"array": "M", "index": 1}, "to": {"array": "U", "index": 1}, "text": "A"},
            {"from": {"array": "M", "index": 2}, "to": {"array": "U", "index": 2}, "text": "V"},
            {"from": {"array": "M", "index": 3}, "to": {"array": "U", "index": 3}, "text": "A"},
            {"from": {"array": "M", "index": 4}, "to": {"array": "U", "index": 4}, "text": "␣"},
            {"from": {"array": "M", "index": 5}, "to": {"array": "U", "index": 5}, "text": "S"},
            {"from": {"array": "M", "index": 6}, "to": {"array": "U", "index": 6}, "text": "T"},
            {"from": {"array": "M", "index": 7}, "to": {"array": "U", "index": 7}, "text": "R"},
            {"from": {"array": "M", "index": 8}, "to": {"array": "U", "index": 8}, "text": "I"},
            {"from": {"array": "M", "index": 9}, "to": {"array": "U", "index": 9}, "text": "N"},
            {"from": {"array": "M", "index": 10}, "to": {"array": "U", "index": 10}, "text": "G"},
            {"from": {"array": "M", "index": 11}, "to": {"array": "U", "index": 11}, "text": "S"},
            {"from": {"array": "M", "index": 12}, "to": {"array": "U", "index": 12}, "text": "␣"},
            {"from": {"array": "M", "index": 13}, "to": {"array": "U", "index": 13}, "text": "L"},
            {"from": {"array": "M", "index": 14}, "to": {"array": "U", "index": 14}, "text": "A"},
            {"from": {"array": "M", "index": 15}, "to": {"array": "U", "index": 15}, "text": "B"}
          ]
        },
        {
          "line": 5,
          "caption": "The new String prints. `message` still points at the original, unchanged.",
          "print": "Uppercase: JAVA STRINGS LAB\n",
          "from": {"array": "U"},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "note": "unchanged"},
            {"id": "U", "text": "JAVA STRINGS LAB", "class": "String"}
          ]
        },
        {
          "line": 6,
          "caption": "`toLowerCase()` is another factory: another new String. Nothing kept an arrow to the capitals, so that String is now garbage.",
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "note": "unchanged"},
            {"id": "U", "text": "JAVA STRINGS LAB", "class": "String", "dead": true},
            {"id": "L", "text": "java strings lab", "class": "String"}
          ],
          "flow": [
            {"from": {"array": "M", "index": 0}, "to": {"array": "L", "index": 0}, "text": "j"},
            {"from": {"array": "M", "index": 1}, "to": {"array": "L", "index": 1}, "text": "a"},
            {"from": {"array": "M", "index": 2}, "to": {"array": "L", "index": 2}, "text": "v"},
            {"from": {"array": "M", "index": 3}, "to": {"array": "L", "index": 3}, "text": "a"},
            {"from": {"array": "M", "index": 4}, "to": {"array": "L", "index": 4}, "text": "␣"},
            {"from": {"array": "M", "index": 5}, "to": {"array": "L", "index": 5}, "text": "s"},
            {"from": {"array": "M", "index": 6}, "to": {"array": "L", "index": 6}, "text": "t"},
            {"from": {"array": "M", "index": 7}, "to": {"array": "L", "index": 7}, "text": "r"},
            {"from": {"array": "M", "index": 8}, "to": {"array": "L", "index": 8}, "text": "i"},
            {"from": {"array": "M", "index": 9}, "to": {"array": "L", "index": 9}, "text": "n"},
            {"from": {"array": "M", "index": 10}, "to": {"array": "L", "index": 10}, "text": "g"},
            {"from": {"array": "M", "index": 11}, "to": {"array": "L", "index": 11}, "text": "s"},
            {"from": {"array": "M", "index": 12}, "to": {"array": "L", "index": 12}, "text": "␣"},
            {"from": {"array": "M", "index": 13}, "to": {"array": "L", "index": 13}, "text": "l"},
            {"from": {"array": "M", "index": 14}, "to": {"array": "L", "index": 14}, "text": "a"},
            {"from": {"array": "M", "index": 15}, "to": {"array": "L", "index": 15}, "text": "b"}
          ]
        },
        {
          "line": 6,
          "caption": "It prints, and `message` still holds the same 16 characters.",
          "print": "Lowercase: java strings lab\n",
          "from": {"array": "L"},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "note": "unchanged"},
            {"id": "U", "text": "JAVA STRINGS LAB", "class": "String", "dead": true},
            {"id": "L", "text": "java strings lab", "class": "String"}
          ]
        },
        {
          "line": 7,
          "caption": "`isEmpty()` asks whether the length is 0. It is 16, so `false`.",
          "print": "Is empty? false\n",
          "from": {"array": "M"},
          "vars": [{"name": "message", "ref": "M"}],
          "arrays": [
            {"id": "M", "text": "Java Strings Lab", "class": "String", "pool": true, "ruler": "length 16"},
            {"id": "L", "text": "java strings lab", "class": "String", "dead": true}
          ]
        }
      ]
    },
    {
      "example": null,

{
  "id": "searching-and-slicing",
  "title": "Search, slice, replace, split",
  "layout": "wide",
  "segments": [
    {
      "example": "section 7",
      "extra": false,
      "title": "Four methods, four answers, one unchanged String",
      "code": [
        "String logEntry = \"INFO: Connected at 10:45\";",
        "boolean containsTime = logEntry.contains(\"10:45\");",
        "String level = logEntry.substring(0, logEntry.indexOf(':'));",
        "String replaced = logEntry.replace(\"INFO\", \"DEBUG\");",
        "String[] parts = logEntry.split(\": \");"
      ],
      "steps": [
        {
          "line": 1,
          "caption": "`logEntry` points at a String of 24 characters, indexes 0 to 23.",
          "vars": [{"name": "logEntry", "ref": "L"}],
          "arrays": [
            {"id": "L", "text": "INFO: Connected at 10:45", "class": "String", "pool": true, "ruler": "length 24"}
          ]
        },
        {
          "line": 2,
          "caption": "`contains(\"10:45\")` looks for that run of characters anywhere in the text. It is there, at indexes 19 to 23, so `containsTime` is `true`.",
          "vars": [{"name": "logEntry", "ref": "L"}, {"name": "containsTime", "value": "true"}],
          "arrays": [
            {
              "id": "L",
              "text": "INFO: Connected at 10:45",
              "class": "String",
              "pool": true,
              "match": [19, 20, 21, 22, 23]
            }
          ]
        },
        {
          "line": 3,
          "caption": "`indexOf(':')` scans from the front, box by box, and stops at the first colon: index 4. The colon in `10:45` is never reached.",
          "vars": [{"name": "logEntry", "ref": "L"}, {"name": "containsTime", "value": "true"}],
          "arrays": [
            {
              "id": "L",
              "text": "INFO: Connected at 10:45",
              "class": "String",
              "pool": true,
              "match": [4],
              "marks": {"4": "index 4"}
            }
          ]
        },
        {
          "line": 3,
          "caption": "`substring(0, 4)` copies the characters from index 0 up to, but not including, index 4 into a new String. The colon at the end index stays out.",
          "vars": [
            {"name": "logEntry", "ref": "L"},
            {"name": "containsTime", "value": "true"},
            {"name": "level", "ref": "V"}
          ],
          "arrays": [
            {
              "id": "L",
              "text": "INFO: Connected at 10:45",
              "class": "String",
              "pool": true,
              "highlight": [0, 1, 2, 3],
              "marks": {"0": "begin", "4": "end"}
            },
            {"id": "V", "text": "INFO", "class": "String"}
          ],
          "flow": [
            {"from": {"array": "L", "index": 0}, "to": {"array": "V", "index": 0}, "text": "I"},
            {"from": {"array": "L", "index": 1}, "to": {"array": "V", "index": 1}, "text": "N"},
            {"from": {"array": "L", "index": 2}, "to": {"array": "V", "index": 2}, "text": "F"},
            {"from": {"array": "L", "index": 3}, "to": {"array": "V", "index": 3}, "text": "O"}
          ]
        },
        {
          "line": 4,
          "caption": "`replace` builds yet another String, with `DEBUG` where `INFO` was. `logEntry` itself is unchanged: every method that seems to change a String makes a new one.",
          "vars": [
            {"name": "logEntry", "ref": "L"},
            {"name": "containsTime", "value": "true"},
            {"name": "level", "ref": "V"},
            {"name": "replaced", "ref": "R"}
          ],
          "arrays": [
            {"id": "L", "text": "INFO: Connected at 10:45", "class": "String", "pool": true, "note": "unchanged"},
            {"id": "V", "text": "INFO", "class": "String"},
            {"id": "R", "text": "DEBUG: Connected at 10:45", "class": "String"}
          ]
        },
        {
          "line": 5,
          "caption": "`split(\": \")` cuts wherever a colon is followed by a space. That happens once: the colon in `10:45` has no space after it. So `parts` holds two Strings.",
          "vars": [
            {"name": "logEntry", "ref": "L"},
            {"name": "containsTime", "value": "true"},
            {"name": "level", "ref": "V"},
            {"name": "replaced", "ref": "R"},
            {"name": "parts", "ref": "P"}
          ],
          "arrays": [
            {"id": "L", "text": "INFO: Connected at 10:45", "class": "String", "pool": true, "highlight": [4, 5]},
            {"id": "V", "text": "INFO", "class": "String"},
            {"id": "R", "text": "DEBUG: Connected at 10:45", "class": "String"},
            {"id": "P", "values": ["\"INFO\"", "\"Connected at 10:45\""], "class": "String[]"}
          ]
        }
      ]
    }
  ]
}

{
  "name": "object-oriented-computing",
  "private": true,
  "description": "Local Marp preview/build tooling for the OOC module repo (same pinned marp-cli as CI)",
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.0"
  },
  "scripts": {
    "preview": "marp -s --html . --theme-set themes/ooc.css",
    "preview:intro": "marp --preview --html --allow-local-files weeks/week-01-introduction/slides.md --theme-set themes/ooc.css",
    "export:intro": "marp --html --allow-local-files weeks/week-01-introduction/slides.md -o build/week-01-introduction/slides.pdf --theme-set themes/ooc.css"
  }
}
